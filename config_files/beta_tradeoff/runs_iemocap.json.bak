                   "train_cache_file_name": "SET", "validation_cache_file_name": "SET", "test_cache_file_name": "SET"}},
    {"name": "FD", "transfer_from": "timit", "checkpoint_dir": "SET/iemocap_from_timit/filter/decvae_filter_b{btag}/SET",

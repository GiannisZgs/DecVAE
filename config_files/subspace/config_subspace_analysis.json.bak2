{
    "models_file": "config_files/subspace/models_subspace.json",
    "output_dir": "../post-training_results/subspace",
    "n_sub": 30000,
    "n_folds": 5,
    "fold_seed": 0,
    "subsample_seed": 0,
    "n_null": 20,
    "null_folds": [0],
    "null_seed": 0,
    "max_pairs": 5000,
    "min_pairs": 100,
    "probe_C": 1.0,
    "probe_max_iter": 1000,
    "importance": "lr",
    "top_frac": 0.1,
    "cka_between_configs": [["ewt_b01", "fd_b01"]],
    "headline_config": "ewt_b01",
    "n_jobs": 1,
    "self_test": false,
    "outputs_only": false,
    "datasets": {
        "sim_vowels": {"speaker_factor": "speaker_frame", "ground_truth": "simvowels_formants",
                       "vowel_classes": ["I", "a", "aw", "e", "u"]},
        "timit":      {"speaker_factor": "speaker_frame", "n_sub": 60000},
        "iemocap":    {"speaker_factor": "speaker_frame"},
        "VOC_ALS":    {"speaker_factor": "speaker_frame",
                       "swap_match": {"king_stage_frame": ["phoneme_frame"]},
                       "extra_runs": [{"tag": "speaker_disjoint", "split": "group_speaker",
                                       "factors": ["king_stage_frame", "phoneme_frame"]}]}
    }
}

"""Pilot timing of one metric suite run on a SimVowels eval dump and on synthetic latents.

python metric_suite_pilot_timing.py [--dump <dir>/<tag>_all_vowel_speaker_frame.npz] [--n_sub 20000]
    [--synthetic_d 768] [--n_jobs 4]
"""

import argparse
import os
import sys
import time
import types
import numpy as np

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..")))
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "simulations")))
from disentanglement_utils.metric_suite import compute_metric_suite, load_dump, args_from_sidecar, table_columns
import metric_sensitivity_synthetic as synthetic


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dump", default=None)
    parser.add_argument("--n_sub", type=int, default=20000)
    parser.add_argument("--synthetic_d", type=int, default=768)
    parser.add_argument("--n_jobs", type=int, default=1)
    args = parser.parse_args()

    if args.dump:
        mus, ys, n_train, sidecar = load_dump(args.dump)
        idx = np.sort(np.random.default_rng(0).choice(mus.shape[1], size=min(args.n_sub, mus.shape[1]), replace=False))
        start = time.time()
        res = compute_metric_suite(mus[:, idx], ys[:, idx], int(np.sum(idx < n_train)), sidecar["targets"],
                                   args_from_sidecar(sidecar, args.n_jobs), split="speaker")
        print(f"Dump {sidecar['tag']}: N = {len(idx)}, d = {mus.shape[0]}: {time.time() - start:.1f} s")
        print(table_columns(res))

    cfg = {**synthetic.DEFAULT, "d": args.synthetic_d}
    mus, ys, _ = synthetic.generate("D", cfg, 0)
    run_args = types.SimpleNamespace(train_data_percent=synthetic.TRAIN_DATA_PERCENT,
                                     dev_data_percent=synthetic.DEV_DATA_PERCENT, disentanglement_num_workers=args.n_jobs)
    start = time.time()
    res = compute_metric_suite(mus, ys, int(synthetic.TRAIN_DATA_PERCENT * cfg["n"]), ["A", "B"], run_args, split="plain")
    print(f"Synthetic D: N = {cfg['n']}, d = {cfg['d']}: {time.time() - start:.1f} s")
    print(table_columns(res))


if __name__ == "__main__":
    main()
